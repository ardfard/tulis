                    {
                      "type": "frame",
                      "id": "S55WHC",
                      "name": "P5",
                      "width": "fill_container",
                      "layout": "vertical",
                      "children": [
                        {
                          "type": "frame",
                          "id": "cr1Y7",
                          "name": "Line 1",
                          "width": "fill_container",
                          "alignItems": "center",
                          "children": [
                            {
                              "type": "text",
                              "id": "xTbBL",
                              "name": "Text",
                              "fill": "$text",
                              "content": "Doubting costs nothing; nothing is overwritten. Each option",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-mono",
                              "fontSize": 15,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "Pto2T",
                          "name": "Line 2",
                          "width": "fill_container",
                          "alignItems": "center",
                          "children": [
                            {
                              "type": "text",
                              "id": "iooQM",
                              "name": "Text",
                              "fill": "$text",
                              "content": "is a version, and the page only ever shows one of them.",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-mono",
                              "fontSize": 15,
                              "fontWeight": "normal"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "ybyzP",
                      "name": "P6",
                      "width": "fill_container",
                      "layout": "vertical",
                      "children": [
                        {
                          "type": "frame",
