                                        {
                                          "type": "text",
                                          "id": "PUvMn",
                                          "name": "Text",
                                          "fill": "$text",
                                          "content": "Most of the work in writing happens after the first draft. You",
                                          "lineHeight": 1.6,
                                          "fontFamily": "$font-mono",
                                          "fontSize": 15,
                                          "fontWeight": "normal"
                                        }
                                      ]
                                    },
                                    {
                                      "type": "frame",
                                      "id": "gbgB0",
                                      "name": "Line",
