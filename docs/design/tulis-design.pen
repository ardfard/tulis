                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "ru7Qg",
                  "name": "Spec Keys",
                  "fill": "#8b7cf6",
                  "textGrowth": "fixed-width",
                  "width": 1140,
                  "content": "LAB button  ·  Ctrl+L  ·  vim gl      Ctrl+Shift+T  paragraph scope      Ctrl+Shift+Alt+T  document scope      ↑↓ or j k + Enter choose · Esc closes",
                  "lineHeight": 1.5,
                  "fontFamily": "IBM Plex Mono",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "b2Mw2",
                  "name": "Spec Note",
                  "fill": "#a3a7ba",
                  "textGrowth": "fixed-width",
                  "width": 1140,
                  "content": "Opens above the LAB button. Scope is the selection's paragraphs, or the whole document. Six checks and five trim levels. Typos become AI alternates; the other checks tint passages and explain each one. Trim levels preview the cuts as faded text.",
                  "lineHeight": 1.5,
                  "fontFamily": "Inter",
                  "fontSize": 15,
                  "fontWeight": "normal"
                },
