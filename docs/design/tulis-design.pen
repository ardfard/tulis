              "name": "Section Title",
              "fill": "#f2f3f8",
              "content": "05  The Lab",
              "fontFamily": "Inter",
              "fontSize": 44,
              "fontWeight": "700"
            },
            {
              "type": "text",
              "id": "A0Wsv2",
              "name": "Section Subtitle",
              "fill": "#a3a7ba",
              "textGrowth": "fixed-width",
              "width": 1500,
              "content": "Trim and review in one popover. Everything the Lab proposes is a preview first: faded cuts, tinted marks, or AI alternates you can cycle. Nothing is deleted, and every action is one undo step. Esc stops a run, including requests still waiting in line.",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 18,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "Z0BkvA",
          "name": "Row",
          "gap": 80,
          "children": [
            {
              "type": "frame",
