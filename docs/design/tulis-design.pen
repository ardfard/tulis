                                      "children": [
                                        {
                                          "type": "text",
                                          "id": "rDuqw",
                                          "name": "Text",
                                          "fill": "$text",
                                          "content": "choose a word, doubt it, and try another. Tulis keeps the",
                                          "lineHeight": 1.6,
                                          "fontFamily": "$font-mono",
                                          "fontSize": 15,
                                          "fontWeight": "normal"
                                        }
                                      ]
                                    },
                                    {
                                      "type": "frame",
                                      "id": "t2V03E",
                                      "name": "Line",
