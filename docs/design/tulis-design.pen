                                      "type": "frame",
                                      "id": "jHD1K",
                                      "name": "Line",
                                      "children": [
                                        {
                                          "type": "text",
                                          "id": "HfJiC",
                                          "name": "Text",
                                          "fill": "$text",
                                          "content": "choose a word, doubt it, and try another. Tulis keeps the",
                                          "lineHeight": 1.6,
                                          "fontFamily": "$font-mono",
                                          "fontSize": 15,
                                          "fontWeight": "normal"
                                        }
                                      ]
                                    },
                                    {
                                      "type": "frame",
                                      "id": "axHyo",
