                                        {
                                          "type": "text",
                                          "id": "axBvy",
                                          "name": "Text",
                                          "fill": "$text",
                                          "content": "options close, so doubting costs nothing.",
                                          "lineHeight": 1.6,
                                          "fontFamily": "$font-mono",
                                          "fontSize": 15,
                                          "fontWeight": "normal"
                                        }
                                      ]
                                    }
