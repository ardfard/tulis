            {
              "type": "frame",
              "id": "NHhp1",
              "name": "Card: Rules",
              "width": 740,
              "height": 330,
              "fill": "#151823",
              "cornerRadius": 16,
              "layout": "vertical",
              "gap": 14,
              "padding": 28,
              "children": [
                {
                  "type": "text",
                  "id": "q5rGX",
                  "name": "Card Title",
                  "fill": "#f2f3f8",
                  "content": "Rules",
                  "fontFamily": "Inter",
                  "fontSize": 22,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "Dcy5Z",
                  "name": "Rule",
                  "fill": "#b9bdd0",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "•  Animate opacity and position only. Never animate layout: the line breaks and the 24px pitch stay still while text fades.",
                  "lineHeight": 1.5,
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "X9ymGD",
                  "name": "Rule",
                  "fill": "#b9bdd0",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "•  Typing is never delayed. A key press during an animation jumps it to its end state.",
                  "lineHeight": 1.5,
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "z2cx7N",
                  "name": "Rule",
                  "fill": "#b9bdd0",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "•  Overlays (sidebar, Overflow, menus, Lab popover, cheat sheet) appear and leave instantly.",
                  "lineHeight": 1.5,
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "UMnuu",
                  "name": "Rule",
                  "fill": "#b9bdd0",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "•  Reduced motion (OS setting): crossfades become instant swaps, scrolls jump, the scan line stays as a static tint on the scope.",
                  "lineHeight": 1.5,
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        },
