                              "name": "Text",
                              "fill": "$text",
                              "content": "The Long Middle",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-mono",
                              "fontSize": 15,
                              "fontWeight": "700"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "DTYFs",
                      "name": "Paragraph 1",
                      "layout": "vertical",
                      "children": [
                        {
                          "type": "frame",
                          "id": "V1mYZ",
                          "name": "Line",
                          "height": 24,
                          "alignItems": "center",
                          "children": [
                            {
                              "type": "text",
                              "id": "MSinc",
                              "name": "Text",
                              "fill": "$text",
                              "content": "The trouble with a first draft is that you can see all of it at",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-mono",
                              "fontSize": 15,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "D8CCQ",
                          "name": "Line",
                          "height": 24,
                          "alignItems": "center",
                          "children": [
                            {
                              "type": "text",
                              "id": "AOQ2s",
                              "name": "Text",
                              "fill": "$text",
                              "content": "once. Every gap, every dull sentence, every paragraph that starts",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-mono",
                              "fontSize": 15,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "EKv3V",
                          "name": "Line",
                          "height": 24,
                          "alignItems": "center",
                          "children": [
                            {
                              "type": "text",
                              "id": "B5hOst",
                              "name": "Text",
                              "fill": "$text",
                              "content": "to wobble. The eye treats the whole page as one surface and",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-mono",
                              "fontSize": 15,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "I27iKt",
                          "name": "Line",
                          "height": 24,
                          "alignItems": "center",
                          "children": [
                            {
                              "type": "text",
                              "id": "MwRmg",
                              "name": "Text",
                              "fill": "$text",
                              "content": "finds nothing wrong with it.",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-mono",
                              "fontSize": 15,
                              "fontWeight": "normal"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "pFVlY",
                      "name": "Paragraph 2",
                      "layout": "vertical",
                      "children": [
                        {
                          "type": "frame",
                          "id": "wsyQR",
                          "name": "Line",
                          "height": 24,
                          "alignItems": "center",
                          "children": [
                            {
                              "type": "text",
                              "id": "olcV2",
                              "name": "Text",
                              "fill": "$text",
                              "content": "Editors do the ",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-mono",
                              "fontSize": 15,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "ht9PJ",
                              "name": "Text",
                              "fill": "$text",
                              "content": "opposite",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-mono",
                              "fontSize": 15,
                              "fontWeight": "700"
                            },
                            {
                              "type": "text",
                              "id": "ZgKOm",
                              "name": "Text",
                              "fill": "$text",
                              "content": ". They work in small amounts, holding",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-mono",
                              "fontSize": 15,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "w6ci8C",
                          "name": "Line",
                          "height": 24,
                          "alignItems": "center",
                          "children": [
                            {
                              "type": "text",
                              "id": "ve5qX",
                              "name": "Text",
                              "fill": "$text",
                              "content": "one paragraph in the mind until it says what it means, then",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-mono",
                              "fontSize": 15,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "G65AH",
                          "name": "Line",
                          "height": 24,
                          "alignItems": "center",
                          "children": [
                            {
                              "type": "text",
                              "id": "Y6FycP",
                              "name": "Text",
                              "fill": "$text",
                              "content": "they move on. Nothing is finished at the level of the document;",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-mono",
                              "fontSize": 15,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "nKHA4",
                          "name": "Line",
                          "height": 24,
                          "alignItems": "center",
                          "children": [
                            {
                              "type": "text",
                              "id": "SKDHo",
                              "name": "Text",
                              "fill": "$text",
                              "content": "everything is finished at the level of the line.",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-mono",
                              "fontSize": 15,
                              "fontWeight": "normal"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "Dccdx",
                      "name": "Paragraph 3",
                      "layout": "vertical",
                      "children": [
                        {
                          "type": "frame",
                          "id": "yHnF3",
                          "name": "Line",
                          "height": 24,
                          "alignItems": "center",
                          "children": [
                            {
                              "type": "text",
                              "id": "y1m2W6",
                              "name": "Text",
                              "fill": "$text",
                              "content": "I have started to think of revision as a kind of weather. The",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-mono",
                              "fontSize": 15,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "Ej1WP",
                          "name": "Line",
                          "height": 24,
                          "alignItems": "center",
                          "children": [
                            {
                              "type": "text",
                              "id": "JLHE3",
                              "name": "Text",
                              "fill": "$text",
                              "content": "page has a front that moves in, and the only useful thing to",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-mono",
                              "fontSize": 15,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "AQDb7",
                          "name": "Line",
                          "height": 24,
                          "alignItems": "center",
                          "children": [
                            {
                              "type": "text",
                              "id": "zOplK",
                              "name": "Text",
                              "fill": "$text",
                              "content": "do is to notice where it is and stand there.",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-mono",
                              "fontSize": 15,
                              "fontWeight": "normal"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "kC1yY",
                      "name": "Paragraph 4",
                      "layout": "vertical",
                      "children": [
                        {
                          "type": "frame",
                          "id": "KKMq7",
                          "name": "Line",
                          "height": 24,
                          "alignItems": "center",
                          "children": [
                            {
                              "type": "text",
                              "id": "Ni8EP",
                              "name": "Text",
                              "fill": "$text",
                              "content": "Tulis keeps a stack of these fragments in the panel on the",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-mono",
                              "fontSize": 15,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "SXxZY",
                          "name": "Line",
                          "height": 24,
                          "alignItems": "center",
                          "children": [
                            {
                              "type": "text",
                              "id": "EMR7c",
                              "name": "Text",
                              "fill": "$text",
                              "content": "right, each one pinned to the line that asked for it. Accept a",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-mono",
                              "fontSize": 15,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "oOuFx",
                          "name": "Line",
                          "height": 24,
                          "alignItems": "center",
                          "children": [
                            {
                              "type": "text",
                              "id": "SOz4X",
                              "name": "Text",
                              "fill": "$text",
                              "content": "note and it folds into the text. Ignore it and it goes quiet,",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-mono",
                              "fontSize": 15,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "oA2mi",
                          "name": "Line",
                          "height": 24,
                          "alignItems": "center",
                          "children": [
                            {
                              "type": "text",
                              "id": "j6qUMB",
                              "name": "Text",
                              "fill": "$text",
                              "content": "but it is not lost.",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-mono",
                              "fontSize": 15,
                              "fontWeight": "normal"
                            }
                          ]
                        }
                      ]
