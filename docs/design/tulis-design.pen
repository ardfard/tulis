                          "name": "Line 1",
                          "width": "fill_container",
                          "alignItems": "center",
                          "children": [
                            {
                              "type": "text",
                              "id": "LLPLx",
                              "name": "Text",
                              "fill": "$text",
                              "content": "Ghosts stay in the document, faint enough to ignore, until a",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-mono",
                              "fontSize": 15,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "E3f49Z",
                          "name": "Line 2",
                          "width": "fill_container",
                          "alignItems": "center",
                          "children": [
                            {
                              "type": "text",
                              "id": "GPkDX",
                              "name": "Text",
                              "fill": "$text",
                              "content": "revision decides whether they were worth keeping.",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-mono",
                              "fontSize": 15,
                              "fontWeight": "normal"
                            }
                          ]
