                                        {
                                          "type": "text",
                                          "id": "SeoNg",
                                          "name": "Text",
                                          "fill": "$text",
                                          "content": "them, keep the one that sounds right, and let the rest fade.",
                                          "lineHeight": 1.6,
                                          "fontFamily": "$font-mono",
                                          "fontSize": 15,
                                          "fontWeight": "normal"
                                        }
                                      ]
