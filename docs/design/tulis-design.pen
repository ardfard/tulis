                                          "type": "text",
                                          "id": "cxM4V",
                                          "name": "Text",
                                          "fill": "$text",
                                          "content": "Some paragraphs do not belong yet. Stash them on the side and",
                                          "lineHeight": 1.6,
                                          "fontFamily": "$font-mono",
                                          "fontSize": 15,
