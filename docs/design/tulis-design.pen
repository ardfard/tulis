                                      "children": [
                                        {
                                          "type": "text",
                                          "id": "lCfYA",
                                          "name": "Text",
                                          "fill": "$text",
                                          "content": "A sentence can carry two or three versions at once. Cycle through",
                                          "lineHeight": 1.6,
                                          "fontFamily": "$font-mono",
                                          "fontSize": 15,
                                          "fontWeight": "normal"
                                        }
                                      ]
                                    },
                                    {
                                      "type": "frame",
                                      "id": "Q1imfq",
                                      "name": "Line",
