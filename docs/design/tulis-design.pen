                  "type": "text",
                  "id": "jMiTg",
                  "name": "Spec Note",
                  "fill": "#a3a7ba",
                  "textGrowth": "fixed-width",
                  "width": 1600,
                  "content": "The paragraph stays where it is; only its text changes. A tint marks the block so your eye finds it, the old text fades out, the new one fades in, and the shown dot moves. Line breaks reflow at the switch, never during the fade.",
                  "lineHeight": 1.5,
                  "fontFamily": "Inter",
                  "fontSize": 15,
                  "fontWeight": "normal"
