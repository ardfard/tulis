                },
                {
                  "type": "text",
                  "id": "Z09rG",
                  "name": "Spec Keys",
                  "fill": "#8b7cf6",
                  "textGrowth": "fixed-width",
                  "width": 1140,
                  "content": "Footer Share ▾ opens two icon buttons, X and LinkedIn. Either copies the selection (or the whole document) as Markdown and opens the site with it pre-filled",
                  "lineHeight": 1.5,
                  "fontFamily": "IBM Plex Mono",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "Rd6Gc",
                  "name": "Spec Note",
                  "fill": "#a3a7ba",
                  "textGrowth": "fixed-width",
                  "width": 1140,
                  "content": "Toasts replace the old status bar: centered above the footer, at most two, fading after about three seconds. Sharing always copies to the clipboard first; X posts are cut to 280 characters, with a toast saying so. The Share menu is drawn open here for reference; it closes when you pick an item. The header shows the file name and a dot when there are unsaved changes.",
                  "lineHeight": 1.5,
                  "fontFamily": "Inter",
                  "fontSize": 15,
                  "fontWeight": "normal"
                },
